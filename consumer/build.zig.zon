.{
    .name = .libpng_consumer,
    .version = "0.1.0",
    // Zig 0.16.0 suggested this pre-port fingerprint (observed with Zig 0.16;
    // not rechecked on 0.17).
    .fingerprint = 0x317db5b607ee98ae,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // A relative path, not a registry or archive URL. The consumer is the
        // proof that `dep.module("libpng")` works from outside the package that
        // defines it; resolving that through the network would make the proof
        // depend on a published state of the world instead.
        .libpng = .{ .path = ".." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}